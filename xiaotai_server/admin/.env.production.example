# If the admin site and API are served from the same domain, leave this empty
# and the build will call /api/v1.
VITE_API_BASE_URL=

# If the admin site is on another domain, set:
# VITE_API_BASE_URL=https://api.xthblog.site/api/v1

# Password gate shown before the administrator login page.
VITE_ADMIN_ACCESS_PASSWORD=change-this-before-build
