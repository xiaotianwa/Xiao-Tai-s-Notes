generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String         @id @default(cuid())
  username      String         @unique
  nickname      String
  role          String         @default("user")
  passwordHash  String         @map("password_hash")
  status        String         @default("active")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  refreshTokens RefreshToken[]
  spaces        SpaceMember[]
  devices       Device[]
  syncItems     SyncItem[]
  mediaAssets   MediaAsset[]
  auditLogs     AuditLog[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("refresh_tokens")
}

model Space {
  id          String        @id @default(cuid())
  name        String
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  members     SpaceMember[]
  syncItems   SyncItem[]
  mediaAssets MediaAsset[]

  @@map("spaces")
}

model SpaceMember {
  id        String   @id @default(cuid())
  spaceId   String   @map("space_id")
  userId    String   @map("user_id")
  role      String   @default("member")
  createdAt DateTime @default(now()) @map("created_at")
  space     Space    @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([spaceId, userId])
  @@index([userId])
  @@map("space_members")
}

model Device {
  id             String       @id
  userId         String       @map("user_id")
  deviceName     String       @default("未知设备") @map("device_name")
  platform       String       @default("unknown")
  appVersionName String?      @map("app_version_name")
  appVersionCode Int?         @map("app_version_code")
  lastSeenAt     DateTime?    @map("last_seen_at")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncItems      SyncItem[]
  mediaAssets    MediaAsset[]

  @@index([userId])
  @@index([lastSeenAt])
  @@map("devices")
}

model SyncItem {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  spaceId         String    @map("space_id")
  deviceId        String?   @map("device_id")
  type            String
  clientId        String    @map("client_id")
  dataJson        String    @map("data_json")
  version         Int       @default(1)
  clientUpdatedAt DateTime  @map("client_updated_at")
  serverUpdatedAt DateTime  @default(now()) @map("server_updated_at")
  deletedAt       DateTime? @map("deleted_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  space           Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  device          Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([userId, type, clientId])
  @@index([userId, serverUpdatedAt])
  @@index([userId, type])
  @@index([spaceId])
  @@index([deletedAt])
  @@map("sync_items")
}

model AuditLog {
  id           String   @id @default(cuid())
  actorUserId  String   @map("actor_user_id")
  action       String
  targetType   String?  @map("target_type")
  targetId     String?  @map("target_id")
  ip           String?
  userAgent    String?  @map("user_agent")
  metadataJson String?  @map("metadata_json")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  actor        User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)

  @@index([actorUserId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model AppVersion {
  id          String   @id @default(cuid())
  platform    String
  channel     String   @default("private")
  versionName String   @map("version_name")
  versionCode Int      @map("version_code")
  apkUrl      String   @map("apk_url")
  apkPath     String?  @map("apk_path")
  apkSize     Int?     @map("apk_size")
  sha256      String?
  changelog   String?
  forceUpdate Boolean  @default(false) @map("force_update")
  enabled     Boolean  @default(true)
  createdBy   String   @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([platform, channel, enabled])
  @@index([versionCode])
  @@index([createdAt])
  @@map("app_versions")
}

model MediaAsset {
  id           String    @id @default(cuid())
  userId       String    @map("user_id")
  spaceId      String    @map("space_id")
  deviceId     String?   @map("device_id")
  originalName String    @map("original_name")
  mimeType     String    @map("mime_type")
  size         Int
  sha256       String
  filePath     String    @map("file_path")
  thumbPath    String?   @map("thumb_path")
  takenAt      DateTime? @map("taken_at")
  uploadedAt   DateTime  @default(now()) @map("uploaded_at")
  deletedAt    DateTime? @map("deleted_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  space        Space     @relation(fields: [spaceId], references: [id], onDelete: Cascade)
  device       Device?   @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@index([userId, uploadedAt])
  @@index([spaceId])
  @@index([deviceId])
  @@index([sha256])
  @@index([deletedAt])
  @@map("media_assets")
}

model Announcement {
  id          String    @id @default(cuid())
  title       String
  content     String
  type        String    @default("info")
  priority    Int       @default(0)
  targetUsers String?   @map("target_users")
  imageUrl    String?   @map("image_url")
  startAt     DateTime? @map("start_at")
  endAt       DateTime? @map("end_at")
  enabled     Boolean   @default(true)
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@index([enabled, startAt, endAt])
  @@index([priority])
  @@index([createdAt])
  @@map("announcements")
}

model DailyComic {
  id          String            @id @default(cuid())
  title       String
  description String?
  publishDate DateTime          @map("publish_date")
  enabled     Boolean           @default(true)
  createdBy   String            @map("created_by")
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")
  images      DailyComicImage[]

  @@unique([publishDate])
  @@index([enabled, publishDate])
  @@index([createdAt])
  @@map("daily_comics")
}

model DailyComicImage {
  id           String     @id @default(cuid())
  comicId      String     @map("comic_id")
  imageUrl     String     @map("image_url")
  originalName String?    @map("original_name")
  mimeType     String?    @map("mime_type")
  size         Int?
  sortOrder    Int        @default(0) @map("sort_order")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  comic        DailyComic @relation(fields: [comicId], references: [id], onDelete: Cascade)

  @@index([comicId, sortOrder])
  @@map("daily_comic_images")
}

model MusicTrack {
  id              String   @id @default(cuid())
  title           String
  artist          String?
  album           String?
  audioPath       String   @map("audio_path")
  coverPath       String?  @map("cover_path")
  lyrics          String?
  originalName    String   @map("original_name")
  mimeType        String   @map("mime_type")
  size            Int
  durationSeconds Int?     @map("duration_seconds")
  enabled         Boolean  @default(true)
  sortOrder       Int      @default(0) @map("sort_order")
  createdBy       String   @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([enabled, sortOrder])
  @@index([createdAt])
  @@map("music_tracks")
}

model DeviceUsageReport {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  deviceId          String   @map("device_id")
  deviceName        String?  @map("device_name")
  screenOn          Boolean  @default(false) @map("screen_on")
  foregroundPackage String?  @map("foreground_package")
  foregroundAppName String?  @map("foreground_app_name")
  foregroundSinceMs BigInt?  @map("foreground_since_ms")
  todayUsage        Json?    @map("today_usage")
  capturedAt        DateTime @map("captured_at")
  createdAt         DateTime @default(now()) @map("created_at")

  @@index([userId, deviceId, capturedAt(sort: Desc)])
  @@index([userId, capturedAt(sort: Desc)])
  @@map("device_usage_reports")
}

model ForcePush {
  id          String    @id @default(cuid())
  userId      String    @map("user_id")
  deviceId    String?   @map("device_id")
  title       String
  content     String
  level       String    @default("info")
  enabled     Boolean   @default(true)
  deliveredAt DateTime? @map("delivered_at")
  createdBy   String    @map("created_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  expiresAt   DateTime? @map("expires_at")

  @@index([userId, deviceId, enabled, deliveredAt])
  @@index([createdAt(sort: Desc)])
  @@map("force_pushes")
}
